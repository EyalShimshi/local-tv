<?xml version="1.0" encoding="utf-8"?>
<!-- Channels you add yourself may be plain-HTTP streams. Built-in channels, knesset.tv and the
     built-in news feeds are all requested over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
